# Copie este arquivo para .env.local somente se precisar sobrescrever os padrões.
# .env.local é ignorado pelo Git.

# Dados de trabalho do Nymi Gacha. Padrão: <repo>/dados-locais-premium
# GACHA_DATA_ROOT=C:\\NYMI-DADOS

# Exportação para o Editor V4.
# GACHA_EDITOR_V4_PROJECTS_ROOT=C:\\TRABALHO 2\\EDITOR V4\\EDITOR V4\\projects
# GACHA_EDITOR_V4_LOADING_ASSET=C:\\TRABALHO 2\\EDITOR V4\\EDITOR V4\\projects\\Projeto\\assets\\ui\\loading.gif

# Pasta de prints. Padrão atual: C:\PRINTS GACHA NYMI
# GACHA_PRINTS_ROOT=C:\\PRINTS GACHA NYMI

# Portas locais.
# NYMI_UI_PORT=6700
# NYMI_DATA_PORT=6800

# FFmpeg/ffprobe são opcionais, mas recomendados para conversão e metadados de vídeo.
# FFMPEG_PATH=C:\\ffmpeg\\bin\\ffmpeg.exe
# FFPROBE_PATH=C:\\ffmpeg\\bin\\ffprobe.exe
