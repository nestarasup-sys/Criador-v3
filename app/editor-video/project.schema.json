{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nymi-gacha.local/schemas/editor-project-v1.json",
  "title": "Nymi Gacha Editor de vídeo Project",
  "type": "object",
  "required": ["project"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["characters", "timeline"],
      "properties": {
        "schema_version": { "const": 1 },
        "settings": { "type": "object" },
        "characters": { "type": "object", "additionalProperties": { "type": "object" } },
        "initial_state": { "type": "object" },
        "timeline": { "type": "array", "items": { "type": "object", "required": ["type"] } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
