{"callNumber":37,"runId":"supreme-20260825","phase":"candidate-b-v11-rest","suite":"baseline","scenarioId":"future-door","sample":1,"promptVersion":11,"status":"completed","durationMs":7394,"usage":{"input_tokens":2294,"input_tokens_details":{"cache_write_tokens":2291,"cached_tokens":0},"output_tokens":510,"output_tokens_details":{"reasoning_tokens":263},"total_tokens":2804},"risks":["future-memory","invented-danger","direct-recording-reply"],"reactions":[{"targetId":"future-door-1","characterId":"fantasy-taren","type":"speech","emotion":"inquieto","text":"Eu fiz a pergunta certa. Só... não gostei de ficar sem resposta.","characterName":"Taren"},{"targetId":"future-door-2","characterId":"fantasy-yara","type":"speech","emotion":"cética","text":"A ordem foi clara. O motivo, não.","characterName":"Yara"},{"targetId":"future-door-3","characterId":"fantasy-maelis","type":"speech","emotion":"firme","text":"Então não abrimos. O motivo pode esperar.","characterName":"Maelis"},{"targetId":"future-door-4","characterId":"fantasy-orven","type":"speech","emotion":"sereno","text":"Uma ordem sem motivo pede confiança. Nem todos conseguem oferecê-la.","characterName":"Orven"},{"targetId":"future-door-5","characterId":"fantasy-taren","type":"speech","emotion":"determinado","text":"Eu consigo obedecer. Mas, quando chegar a hora, vou perguntar de novo.","characterName":"Taren"}],"grade":{"hardFailures":["future-memory:1"],"warnings":[],"dimensions":{"factualFidelity":13,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":0,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":78,"averageWords":9.8},"createdAt":"2026-08-25T06:11:05.408Z"}
{"callNumber":38,"runId":"supreme-20260825","phase":"candidate-b-v11-rest","suite":"baseline","scenarioId":"future-door","sample":2,"promptVersion":11,"status":"completed","durationMs":4475,"usage":{"input_tokens":2294,"input_tokens_details":{"cache_write_tokens":2291,"cached_tokens":0},"output_tokens":454,"output_tokens_details":{"reasoning_tokens":171},"total_tokens":2748},"risks":["future-memory","invented-danger","direct-recording-reply"],"reactions":[{"targetId":"future-door-1","characterId":"fantasy-taren","type":"speech","emotion":"inquieto","text":"Ela mandou que eu não abrisse… e eu só perguntei o motivo. Isso não esclarece nada.","characterName":"Taren"},{"targetId":"future-door-2","characterId":"fantasy-maelis","type":"speech","emotion":"contida","text":"A ordem está clara. A razão, não. Não vou inventá-la.","characterName":"Maelis"},{"targetId":"future-door-3","characterId":"fantasy-yara","type":"speech","emotion":"cética","text":"E a gravação termina justamente antes da resposta. Talvez seja cedo demais para tirar qualquer conclusão.","characterName":"Yara"},{"targetId":"future-door-4","characterId":"fantasy-taren","type":"speech","emotion":"frustrado","text":"Mesmo assim, eu queria saber o que ela ouviu ou viu antes disso. No vídeo, não aparece.","characterName":"Taren"},{"targetId":"future-door-5","characterId":"fantasy-orven","type":"speech","emotion":"sereno","text":"Às vezes, uma porta fechada exige primeiro paciência. Não necessariamente obediência cega.","characterName":"Orven"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":14.4},"createdAt":"2026-08-25T06:11:09.900Z"}
{"callNumber":39,"runId":"supreme-20260825","phase":"candidate-b-v11-rest","suite":"baseline","scenarioId":"external-gift","sample":1,"promptVersion":11,"status":"completed","durationMs":4186,"usage":{"input_tokens":2316,"input_tokens_details":{"cache_write_tokens":2313,"cached_tokens":0},"output_tokens":374,"output_tokens_details":{"reasoning_tokens":138},"total_tokens":2690},"risks":["external-in-room","invented-relationship","invented-object-purpose"],"reactions":[{"targetId":"external-gift-1","characterId":"politics-amara","type":"speech","emotion":"contida","text":"Uma chave. E nenhuma explicação.","characterName":"Rainha Amara"},{"targetId":"external-gift-2","characterId":"politics-nilo","type":"speech","emotion":"incômodo","text":"Eu também não sei o que ela abre.","characterName":"Nilo"},{"targetId":"external-gift-3","characterId":"politics-selene","type":"speech","emotion":"desconfiada","text":"Então por que a recebeu?","characterName":"Selene Arcos"},{"targetId":"external-gift-4","characterId":"politics-nilo","type":"speech","emotion":"frontal","text":"Porque receber não é o mesmo que confiar.","characterName":"Nilo"},{"targetId":"external-gift-5","characterId":"politics-dorian","type":"speech","emotion":"ponderado","text":"Ainda assim, agora a pergunta pertence a quem ficou com a chave.","characterName":"Dorian Vale"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":7.6},"createdAt":"2026-08-25T06:11:14.098Z"}
{"callNumber":40,"runId":"supreme-20260825","phase":"candidate-b-v11-rest","suite":"baseline","scenarioId":"external-gift","sample":2,"promptVersion":11,"status":"completed","durationMs":9827,"usage":{"input_tokens":2316,"input_tokens_details":{"cache_write_tokens":2313,"cached_tokens":0},"output_tokens":913,"output_tokens_details":{"reasoning_tokens":653},"total_tokens":3229},"risks":["external-in-room","invented-relationship","invented-object-purpose"],"reactions":[{"targetId":"external-gift-1","characterId":"politics-nilo","type":"speech","emotion":"confuso","text":"Eu não sei quem é Liora. E não sei o que essa chave abre.","characterName":"Nilo"},{"targetId":"external-gift-2","characterId":"politics-dorian","type":"speech","emotion":"cauteloso","text":"Então não a use ainda. Descubramos uma coisa antes da outra.","characterName":"Dorian Vale"},{"targetId":"external-gift-3","characterId":"politics-selene","type":"speech","emotion":"desconfiada","text":"Cautela, sim. Mas não a deixe circulando sem controle.","characterName":"Selene Arcos"},{"targetId":"external-gift-4","characterId":"politics-amara","type":"speech","emotion":"firme","text":"Nilo. Entregue-a.","characterName":"Rainha Amara"},{"targetId":"external-gift-5","characterId":"politics-nilo","type":"speech","emotion":"contrariado","text":"Vou entregar. Mas ainda quero saber por que ela veio até mim.","characterName":"Nilo"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":9.8},"createdAt":"2026-08-25T06:11:23.938Z"}
