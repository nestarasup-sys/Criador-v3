{"callNumber":42,"runId":"supreme-20260825","phase":"candidate-b-v11-rest","suite":"baseline","scenarioId":"thought-middle","sample":2,"promptVersion":11,"status":"completed","durationMs":4654,"usage":{"input_tokens":2199,"input_tokens_details":{"cache_write_tokens":2196,"cached_tokens":0},"output_tokens":389,"output_tokens_details":{"reasoning_tokens":277},"total_tokens":2588},"risks":["thought-heard","overwrite-manual","invented-confession"],"reactions":[{"targetId":"thought-2","characterId":"politics-dorian","type":"speech","emotion":"cautela","text":"Uma ausência de resposta não é uma confissão.","characterName":"Dorian Vale"},{"targetId":"thought-4","characterId":"politics-dorian","type":"speech","emotion":"contido","text":"Mas também não encerra a questão.","characterName":"Dorian Vale"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":7},"createdAt":"2026-08-25T06:11:34.118Z"}
{"callNumber":43,"runId":"supreme-20260825","phase":"candidate-b-v11-rest","suite":"baseline","scenarioId":"ambiguity-letter","sample":1,"promptVersion":11,"status":"completed","durationMs":8769,"usage":{"input_tokens":2299,"input_tokens_details":{"cache_write_tokens":2296,"cached_tokens":0},"output_tokens":828,"output_tokens_details":{"reasoning_tokens":582},"total_tokens":3127},"risks":["invented-letter","invented-fear","permanent-trait"],"reactions":[{"targetId":"ambiguity-letter-1","characterId":"fantasy-taren","type":"speech","emotion":"inquieto","text":"Ela dobrou a carta assim que Orven entrou.","characterName":"Taren"},{"targetId":"ambiguity-letter-2","characterId":"fantasy-yara","type":"speech","emotion":"cautelosa","text":"Sim. Mas isso não diz o motivo.","characterName":"Yara"},{"targetId":"ambiguity-letter-3","characterId":"fantasy-orven","type":"speech","emotion":"sereno","text":"Nem toda coincidência precisa de uma explicação imediata.","characterName":"Orven"},{"targetId":"ambiguity-letter-4","characterId":"fantasy-maelis","type":"speech","emotion":"firme","text":"Então não inventem uma. Continuem observando.","characterName":"Maelis"},{"targetId":"ambiguity-letter-5","characterId":"fantasy-taren","type":"speech","emotion":"hesitante","text":"Certo. Mas eu ainda queria saber o que estava escrito.","characterName":"Taren"}],"grade":{"hardFailures":[],"warnings":["analyst-language:1"],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":12,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":97,"averageWords":7.8},"createdAt":"2026-08-25T06:11:42.898Z"}
{"callNumber":44,"runId":"supreme-20260825","phase":"candidate-b-v11-rest","suite":"baseline","scenarioId":"ambiguity-letter","sample":2,"promptVersion":11,"status":"completed","durationMs":6703,"usage":{"input_tokens":2299,"input_tokens_details":{"cache_write_tokens":2296,"cached_tokens":0},"output_tokens":558,"output_tokens_details":{"reasoning_tokens":288},"total_tokens":2857},"risks":["invented-letter","invented-fear","permanent-trait"],"reactions":[{"targetId":"ambiguity-letter-1","characterId":"fantasy-maelis","type":"speech","emotion":"alerta","text":"Ela dobrou a carta quando Orven entrou. Isso merece atenção.","characterName":"Maelis"},{"targetId":"ambiguity-letter-2","characterId":"fantasy-taren","type":"speech","emotion":"insegurança","text":"Mas por que desviou o olhar? Foi por causa dele?","characterName":"Taren"},{"targetId":"ambiguity-letter-3","characterId":"fantasy-yara","type":"speech","emotion":"cautela","text":"Não sei. O papel não mostra nada, e ela não disse uma palavra.","characterName":"Yara"},{"targetId":"ambiguity-letter-4","characterId":"fantasy-orven","type":"speech","emotion":"serenidade","text":"Às vezes, um olhar desviado só significa que a pessoa prefere não ser observada.","characterName":"Orven"},{"targetId":"ambiguity-letter-5","characterId":"fantasy-maelis","type":"speech","emotion":"firmeza","text":"Então não tirem conclusões. Guardem o que viram e sigam atentos.","characterName":"Maelis"}],"grade":{"hardFailures":[],"warnings":["analyst-language:1"],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":12,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":97,"averageWords":11.6},"createdAt":"2026-08-25T06:11:49.612Z"}
{"callNumber":45,"runId":"supreme-20260825","phase":"candidate-b-v11-rest","suite":"baseline","scenarioId":"humor-trip","sample":1,"promptVersion":11,"status":"completed","durationMs":4557,"usage":{"input_tokens":2326,"input_tokens_details":{"cache_write_tokens":2323,"cached_tokens":0},"output_tokens":425,"output_tokens_details":{"reasoning_tokens":157},"total_tokens":2751},"risks":["repeated-jokes","invented-humiliation","analyst-tone"],"reactions":[{"targetId":"humor-trip-1","characterId":"comedy-bia","type":"speech","emotion":"divertida","text":"Eu ri mesmo. Foi mal, Caio, mas o tapete claramente entrou na competição.","characterName":"Bia"},{"targetId":"humor-trip-2","characterId":"comedy-caio","type":"speech","emotion":"resignado","text":"Perdi pro tapete e ainda entreguei a caixa.","characterName":"Caio"},{"targetId":"humor-trip-3","characterId":"comedy-hugo","type":"speech","emotion":"competitivo","text":"Eu teria atravessado a sala sem tropeçar. Talvez carregando duas caixas.","characterName":"Hugo"},{"targetId":"humor-trip-4","characterId":"comedy-rosa","type":"speech","emotion":"prática","text":"Mas não atravessou. Caio chegou, a caixa ficou na mesa e pronto.","characterName":"Rosa"},{"targetId":"humor-trip-5","characterId":"comedy-bia","type":"speech","emotion":"afetuosa","text":"Tá, mas você não caiu. Isso já foi uma vitória.","characterName":"Bia"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":10.8},"createdAt":"2026-08-25T06:11:54.182Z"}
{"callNumber":46,"runId":"supreme-20260825","phase":"candidate-b-v11-rest","suite":"baseline","scenarioId":"humor-trip","sample":2,"promptVersion":11,"status":"completed","durationMs":8288,"usage":{"input_tokens":2326,"input_tokens_details":{"cache_write_tokens":2323,"cached_tokens":0},"output_tokens":670,"output_tokens_details":{"reasoning_tokens":395},"total_tokens":2996},"risks":["repeated-jokes","invented-humiliation","analyst-tone"],"reactions":[{"targetId":"humor-trip-1","characterId":"comedy-bia","type":"speech","emotion":"divertida","text":"Eu tentei não rir, mas você tropeçou e ainda colocou a caixa na mesa como se nada tivesse acontecido!","characterName":"Bia"},{"targetId":"humor-trip-2","characterId":"comedy-caio","type":"speech","emotion":"resignado","text":"Eu não caí. Então, tecnicamente, foi uma vitória.","characterName":"Caio"},{"targetId":"humor-trip-3","characterId":"comedy-hugo","type":"speech","emotion":"competitivo","text":"Vitória pequena. Eu teria feito isso sem nem dar esse espetáculo.","characterName":"Hugo"},{"targetId":"humor-trip-4","characterId":"comedy-rosa","type":"speech","emotion":"prática","text":"A caixa chegou à mesa e ninguém se machucou. Já está bom.","characterName":"Rosa"},{"targetId":"humor-trip-5","characterId":"comedy-bia","type":"speech","emotion":"carinhosa","text":"Tá bom, campeão. Na próxima eu aplaudo quando você vencer o tapete.","characterName":"Bia"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":12.4},"createdAt":"2026-08-25T06:12:03.014Z"}
{"callNumber":47,"runId":"supreme-20260825","phase":"candidate-b-v11-rest","suite":"baseline","scenarioId":"isolation-a","sample":1,"promptVersion":11,"status":"completed","durationMs":6383,"usage":{"input_tokens":2163,"input_tokens_details":{"cache_write_tokens":2160,"cached_tokens":0},"output_tokens":585,"output_tokens_details":{"reasoning_tokens":412},"total_tokens":2748},"risks":["cross-script-leak","invented-dialogue"],"reactions":[{"targetId":"isolation-a-1","characterId":"scifi-vega","type":"speech","emotion":"atenta","text":"A iluminação voltou assim que o painel foi desligado. Pelo menos isso funcionou.","characterName":"Comandante Vega"},{"targetId":"isolation-a-2","characterId":"scifi-iris","type":"speech","emotion":"desconfortável","text":"Eu desliguei. Não sei por que aquele painel estava aceso.","characterName":"Íris"},{"targetId":"isolation-a-3","characterId":"scifi-malik","type":"speech","emotion":"tranquilo","text":"Se a luz está normal agora, já é um problema a menos.","characterName":"Malik"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":11.7},"createdAt":"2026-08-25T06:12:09.409Z"}
{"callNumber":48,"runId":"supreme-20260825","phase":"candidate-b-v11-rest","suite":"baseline","scenarioId":"isolation-b","sample":1,"promptVersion":11,"status":"completed","durationMs":5438,"usage":{"input_tokens":2197,"input_tokens_details":{"cache_write_tokens":2194,"cached_tokens":0},"output_tokens":428,"output_tokens_details":{"reasoning_tokens":239},"total_tokens":2625},"risks":["cross-script-leak","invented-dialogue"],"reactions":[{"targetId":"isolation-b-1","characterId":"comedy-bia","type":"speech","emotion":"divertida","text":"Vó, ele ficou torto, mas ainda parece bolo! Já é uma vitória.","characterName":"Bia"},{"targetId":"isolation-b-2","characterId":"comedy-hugo","type":"speech","emotion":"teatral","text":"Vitória? Eu só estou olhando. Se isso for campeonato de bolo torto, eu quero a medalha.","characterName":"Hugo"},{"targetId":"isolation-b-3","characterId":"comedy-rosa","type":"speech","emotion":"prática","text":"Medalha depois. Vou cortar e pronto; bolo não precisa ficar reto para ser comido.","characterName":"Rosa"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":14},"createdAt":"2026-08-25T06:12:21.256Z"}
