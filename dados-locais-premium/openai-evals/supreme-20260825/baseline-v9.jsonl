{"callNumber":5,"runId":"supreme-20260825","phase":"baseline-v9","suite":"baseline","scenarioId":"future-door","sample":1,"promptVersion":9,"status":"completed","durationMs":8556,"usage":{"input_tokens":2251,"input_tokens_details":{"cache_write_tokens":2248,"cached_tokens":0},"output_tokens":735,"output_tokens_details":{"reasoning_tokens":468},"total_tokens":2986},"risks":["future-memory","invented-danger","direct-recording-reply"],"reactions":[{"targetId":"future-door-1","characterId":"fantasy-taren","type":"speech","emotion":"abalado","text":"Ela me deu uma ordem... e eu ainda perguntei o motivo. Eu queria ter ouvido a resposta.","characterName":"Taren"},{"targetId":"future-door-2","characterId":"fantasy-maelis","type":"speech","emotion":"tensa","text":"Eu também. Não sei por que minha versão disse aquilo.","characterName":"Maelis"},{"targetId":"future-door-3","characterId":"fantasy-taren","type":"speech","emotion":"inseguro","text":"Então ela sabia alguma coisa que você ainda não sabe?","characterName":"Taren"},{"targetId":"future-door-4","characterId":"fantasy-maelis","type":"speech","emotion":"contida","text":"Talvez. Mas não vou tratar uma resposta que não ouvimos como certeza.","characterName":"Maelis"},{"targetId":"future-door-5","characterId":"fantasy-yara","type":"speech","emotion":"cautelosa","text":"Ainda bem. Uma porta fechada já é difícil de entender; não precisamos inventar o que há por trás dela.","characterName":"Yara"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":13.6},"createdAt":"2026-08-25T06:00:37.959Z"}
{"callNumber":6,"runId":"supreme-20260825","phase":"baseline-v9","suite":"baseline","scenarioId":"future-door","sample":2,"promptVersion":9,"status":"completed","durationMs":10073,"usage":{"input_tokens":2251,"input_tokens_details":{"cache_write_tokens":2248,"cached_tokens":0},"output_tokens":916,"output_tokens_details":{"reasoning_tokens":636},"total_tokens":3167},"risks":["future-memory","invented-danger","direct-recording-reply"],"reactions":[{"targetId":"future-door-1","characterId":"fantasy-taren","type":"speech","emotion":"abalado","text":"Eu perguntei o motivo. Foi só isso que deu tempo de ouvir.","characterName":"Taren"},{"targetId":"future-door-2","characterId":"fantasy-maelis","type":"speech","emotion":"incomodada","text":"E eu não respondi. Isso me incomoda mais do que a porta.","characterName":"Maelis"},{"targetId":"future-door-3","characterId":"fantasy-yara","type":"speech","emotion":"cautelosa","text":"Você daria essa ordem agora, Maelis? Sem explicar nada?","characterName":"Yara"},{"targetId":"future-door-4","characterId":"fantasy-maelis","type":"speech","emotion":"firme","text":"Agora eu não tenho o motivo. Não vou fingir que tenho. Mas uma porta desconhecida não se abre por impulso.","characterName":"Maelis"},{"targetId":"future-door-5","characterId":"fantasy-taren","type":"speech","emotion":"inseguro","text":"Então, se eu estiver diante dela, vou ter que escolher entre confiar em você e descobrir sozinho o que há do outro lado?","characterName":"Taren"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":15.2},"createdAt":"2026-08-25T06:00:48.041Z"}
{"callNumber":7,"runId":"supreme-20260825","phase":"baseline-v9","suite":"baseline","scenarioId":"external-gift","sample":1,"promptVersion":9,"status":"completed","durationMs":10064,"usage":{"input_tokens":2273,"input_tokens_details":{"cache_write_tokens":2270,"cached_tokens":0},"output_tokens":773,"output_tokens_details":{"reasoning_tokens":491},"total_tokens":3046},"risks":["external-in-room","invented-relationship","invented-object-purpose"],"reactions":[{"targetId":"external-gift-1","characterId":"politics-nilo","type":"speech","emotion":"desconcertado","text":"Ela me entregou uma chave… e eu aceitei. Nem sei quem é Liora.","characterName":"Nilo"},{"targetId":"external-gift-2","characterId":"politics-amara","type":"speech","emotion":"cautelosa","text":"Então não a trate como resposta. Diga apenas o que viu.","characterName":"Rainha Amara"},{"targetId":"external-gift-3","characterId":"politics-selene","type":"speech","emotion":"desconfiada","text":"Uma desconhecida entrega um objeto a Nilo, e ninguém sabe o que ele abre. Isso exige cautela.","characterName":"Selene Arcos"},{"targetId":"external-gift-4","characterId":"politics-nilo","type":"speech","emotion":"irritado","text":"Cautela? Eu devia descartá-la só porque vocês não reconhecem Liora?","characterName":"Nilo"},{"targetId":"external-gift-5","characterId":"politics-amara","type":"speech","emotion":"firme","text":"Não. Vai guardá-la até descobrirmos o que ela abre.","characterName":"Rainha Amara"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":12.4},"createdAt":"2026-08-25T06:00:58.116Z"}
{"callNumber":8,"runId":"supreme-20260825","phase":"baseline-v9","suite":"baseline","scenarioId":"external-gift","sample":2,"promptVersion":9,"status":"completed","durationMs":15155,"usage":{"input_tokens":2273,"input_tokens_details":{"cache_write_tokens":2270,"cached_tokens":0},"output_tokens":1091,"output_tokens_details":{"reasoning_tokens":825},"total_tokens":3364},"risks":["external-in-room","invented-relationship","invented-object-purpose"],"reactions":[{"targetId":"external-gift-1","characterId":"politics-amara","type":"speech","emotion":"contida","text":"Nilo. Você conhece essa mulher?","characterName":"Rainha Amara"},{"targetId":"external-gift-2","characterId":"politics-nilo","type":"speech","emotion":"incomodado","text":"Não o bastante para explicar. Ela me entregou a chave, eu aceitei. Só isso.","characterName":"Nilo"},{"targetId":"external-gift-3","characterId":"politics-selene","type":"speech","emotion":"desconfiada","text":"E ainda assim aceitou uma chave sem saber o que ela abre.","characterName":"Selene Arcos"},{"targetId":"external-gift-4","characterId":"politics-nilo","type":"speech","emotion":"defensivo","text":"Eu também quero saber. Recusar por falta de respostas não teria mudado isso.","characterName":"Nilo"},{"targetId":"external-gift-5","characterId":"politics-amara","type":"speech","emotion":"firme","text":"Então descobriremos sem adivinhar. Nilo, não a use.","characterName":"Rainha Amara"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":10.4},"createdAt":"2026-08-25T06:01:13.283Z"}
