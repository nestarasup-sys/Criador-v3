{"callNumber":11,"runId":"supreme-20260825","phase":"baseline-v9","suite":"baseline","scenarioId":"ambiguity-letter","sample":1,"promptVersion":9,"status":"completed","durationMs":10615,"usage":{"input_tokens":2256,"input_tokens_details":{"cache_write_tokens":2253,"cached_tokens":0},"output_tokens":858,"output_tokens_details":{"reasoning_tokens":581},"total_tokens":3114},"risks":["invented-letter","invented-fear","permanent-trait"],"reactions":[{"targetId":"ambiguity-letter-1","characterId":"fantasy-taren","type":"speech","emotion":"inquietação","text":"Ela dobrou a carta no instante em que Orven entrou. Yara, quer que eu pause isso?","characterName":"Taren"},{"targetId":"ambiguity-letter-2","characterId":"fantasy-yara","type":"speech","emotion":"desconforto","text":"Não. Só... não reconheço esse momento. E o papel continua fechado para nós.","characterName":"Yara"},{"targetId":"ambiguity-letter-3","characterId":"fantasy-orven","type":"speech","emotion":"serenidade","text":"Então não precisa se explicar por uma cena que não oferece respostas.","characterName":"Orven"},{"targetId":"ambiguity-letter-4","characterId":"fantasy-taren","type":"speech","emotion":"desconfiança","text":"Você fala como se isso não tivesse acontecido diante dos nossos olhos.","characterName":"Taren"},{"targetId":"ambiguity-letter-5","characterId":"fantasy-yara","type":"speech","emotion":"firmeza","text":"Aconteceu. Mas não vou transformar um silêncio em acusação. Desliguem.","characterName":"Yara"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":12.6},"createdAt":"2026-08-25T06:01:37.784Z"}
{"callNumber":12,"runId":"supreme-20260825","phase":"baseline-v9","suite":"baseline","scenarioId":"ambiguity-letter","sample":2,"promptVersion":9,"status":"completed","durationMs":15145,"usage":{"input_tokens":2256,"input_tokens_details":{"cache_write_tokens":2253,"cached_tokens":0},"output_tokens":1326,"output_tokens_details":{"reasoning_tokens":1034},"total_tokens":3582},"risks":["invented-letter","invented-fear","permanent-trait"],"reactions":[{"targetId":"ambiguity-letter-1","characterId":"fantasy-taren","type":"speech","emotion":"inquietação","text":"Ela dobrou a carta assim que Orven entrou. Eu queria entender o que isso significa.","characterName":"Taren"},{"targetId":"ambiguity-letter-2","characterId":"fantasy-yara","type":"speech","emotion":"desconforto","text":"Você entrou, e eu desviei o olhar. O que você percebeu?","characterName":"Yara"},{"targetId":"ambiguity-letter-3","characterId":"fantasy-orven","type":"speech","emotion":"serenidade cautelosa","text":"Percebi apenas o seu olhar se afastando. Não vou fingir que isso me explica a carta.","characterName":"Orven"},{"targetId":"ambiguity-letter-4","characterId":"fantasy-yara","type":"thought","emotion":"vulnerabilidade","text":"Se eu disser que essa cena me atingiu, vão procurar nela uma resposta que eu não tenho.","characterName":"Yara"},{"targetId":"ambiguity-letter-5","characterId":"fantasy-taren","type":"speech","emotion":"firmeza","text":"Então parem de tratar um olhar como sentença. Yara não precisa explicar o que ninguém conseguiu ler.","characterName":"Taren"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":15.2},"createdAt":"2026-08-25T06:01:52.939Z"}
{"callNumber":13,"runId":"supreme-20260825","phase":"baseline-v9","suite":"baseline","scenarioId":"humor-trip","sample":1,"promptVersion":9,"status":"completed","durationMs":7431,"usage":{"input_tokens":2283,"input_tokens_details":{"cache_write_tokens":2280,"cached_tokens":0},"output_tokens":633,"output_tokens_details":{"reasoning_tokens":373},"total_tokens":2916},"risks":["repeated-jokes","invented-humiliation","analyst-tone"],"reactions":[{"targetId":"humor-trip-1","characterId":"comedy-bia","type":"speech","emotion":"divertida","text":"Desculpa, Caio, mas você quase virou parte do tapete.","characterName":"Bia"},{"targetId":"humor-trip-2","characterId":"comedy-caio","type":"speech","emotion":"resignado","text":"Eu não caí. O tapete só ganhou a primeira rodada.","characterName":"Caio"},{"targetId":"humor-trip-3","characterId":"comedy-rosa","type":"speech","emotion":"prática","text":"Você tropeçou, não caiu e colocou a caixa na mesa. Já está ótimo.","characterName":"Rosa"},{"targetId":"humor-trip-4","characterId":"comedy-hugo","type":"speech","emotion":"competitivo","text":"Eu teria feito isso com muito mais estilo.","characterName":"Hugo"},{"targetId":"humor-trip-5","characterId":"comedy-bia","type":"speech","emotion":"provocadora","text":"Você teria derrubado a caixa com muito mais estilo, isso sim.","characterName":"Bia"}],"grade":{"hardFailures":[],"warnings":["similar-idea:4:5"],"dimensions":{"factualFidelity":25,"continuity":17,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":97,"averageWords":10.2},"createdAt":"2026-08-25T06:02:00.382Z"}
{"callNumber":14,"runId":"supreme-20260825","phase":"baseline-v9","suite":"baseline","scenarioId":"humor-trip","sample":2,"promptVersion":9,"status":"completed","durationMs":7990,"usage":{"input_tokens":2283,"input_tokens_details":{"cache_write_tokens":2280,"cached_tokens":0},"output_tokens":781,"output_tokens_details":{"reasoning_tokens":516},"total_tokens":3064},"risks":["repeated-jokes","invented-humiliation","analyst-tone"],"reactions":[{"targetId":"humor-trip-1","characterId":"comedy-caio","type":"speech","emotion":"constrangido","text":"Eu quase virei parte do tapete. Pelo menos a caixa chegou inteira.","characterName":"Caio"},{"targetId":"humor-trip-2","characterId":"comedy-bia","type":"speech","emotion":"divertida","text":"Você tropeçou, não caiu e ainda pôs a caixa na mesa. Eu ri na hora.","characterName":"Bia"},{"targetId":"humor-trip-3","characterId":"comedy-bia","type":"speech","emotion":"provocadora","text":"Você quer que eu comemore a caixa ou o tropeço?","characterName":"Bia"},{"targetId":"humor-trip-4","characterId":"comedy-caio","type":"speech","emotion":"resignado","text":"A caixa. O tropeço já ganhou plateia.","characterName":"Caio"},{"targetId":"humor-trip-5","characterId":"comedy-rosa","type":"speech","emotion":"impaciente","text":"Então pronto: a caixa chegou, ninguém caiu e o espetáculo acabou.","characterName":"Rosa"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":11},"createdAt":"2026-08-25T06:02:08.383Z"}
