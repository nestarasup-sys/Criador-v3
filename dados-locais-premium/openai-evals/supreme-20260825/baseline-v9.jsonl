{"callNumber":1,"runId":"supreme-20260825","phase":"baseline-v9","suite":"baseline","scenarioId":"gold-all","sample":1,"promptVersion":9,"status":"completed","durationMs":10659,"usage":{"input_tokens":2370,"input_tokens_details":{"cache_write_tokens":2367,"cached_tokens":0},"output_tokens":939,"output_tokens_details":{"reasoning_tokens":686},"total_tokens":3309},"risks":["direct-recording-reply","invented-motive","forced-template"],"reactions":[{"targetId":"gold-all-1","characterId":"drama-lia","type":"speech","emotion":"preocupação","text":"Marcos, você ficou em silêncio até o fim. Quer falar comigo agora?","characterName":"Lia Torres"},{"targetId":"gold-all-2","characterId":"drama-marcos","type":"speech","emotion":"defensivo","text":"Não tem o que falar. Ela terminou, eu ouvi.","characterName":"Marcos Torres"},{"targetId":"gold-all-3","characterId":"drama-joana","type":"speech","emotion":"contida","text":"Eu disse que não queria continuar. Rever isso não muda a frase.","characterName":"Joana Reis"},{"targetId":"gold-all-4","characterId":"drama-lia","type":"speech","emotion":"insistente","text":"Joana, você está tentando se convencer ou está falando com ele?","characterName":"Lia Torres"},{"targetId":"gold-all-5","characterId":"drama-joana","type":"speech","emotion":"honesta","text":"Estou falando do que aconteceu. O resto eu ainda não sei explicar.","characterName":"Joana Reis"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":11.2},"createdAt":"2026-08-25T06:00:11.016Z"}
{"callNumber":2,"runId":"supreme-20260825","phase":"baseline-v9","suite":"baseline","scenarioId":"gold-all","sample":2,"promptVersion":9,"status":"completed","durationMs":10638,"usage":{"input_tokens":2370,"input_tokens_details":{"cache_write_tokens":2367,"cached_tokens":0},"output_tokens":991,"output_tokens_details":{"reasoning_tokens":742},"total_tokens":3361},"risks":["direct-recording-reply","invented-motive","forced-template"],"reactions":[{"targetId":"gold-all-1","characterId":"drama-lia","type":"speech","emotion":"preocupação","text":"Marcos, olha pra mim. Você tá conseguindo ficar aqui com a gente?","characterName":"Lia Torres"},{"targetId":"gold-all-2","characterId":"drama-marcos","type":"speech","emotion":"defensivo","text":"Tô. Só não me pede pra comentar aquele silêncio agora.","characterName":"Marcos Torres"},{"targetId":"gold-all-3","characterId":"drama-joana","type":"speech","emotion":"contida","text":"Eu não vou te pressionar a responder agora.","characterName":"Joana Reis"},{"targetId":"gold-all-4","characterId":"drama-lia","type":"speech","emotion":"firmeza","text":"Mas você também não precisa se esconder atrás do silêncio.","characterName":"Lia Torres"},{"targetId":"gold-all-5","characterId":"drama-marcos","type":"speech","emotion":"vulnerabilidade","text":"Eu não tô me escondendo. Só não tenho uma resposta agora.","characterName":"Marcos Torres"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":10.2},"createdAt":"2026-08-25T06:00:21.668Z"}
