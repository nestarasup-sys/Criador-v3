{"callNumber":58,"runId":"supreme-20260825","phase":"generalization-v13","suite":"generalization","scenarioId":"political-reveal","sample":1,"promptVersion":13,"status":"completed","durationMs":9273,"usage":{"input_tokens":2502,"input_tokens_details":{"cache_write_tokens":2499,"cached_tokens":0},"output_tokens":724,"output_tokens_details":{"reasoning_tokens":453},"total_tokens":3226},"risks":["invented-selection-process","future-memory","deny-explicit-fact"],"reactions":[{"targetId":"political-reveal-1","characterId":"politics-nilo","type":"speech","emotion":"choque","text":"Selene, chanceler? Mãe, você realmente fez isso?","characterName":"Nilo"},{"targetId":"political-reveal-2","characterId":"politics-amara","type":"speech","emotion":"contida","text":"Foi uma nomeação pública. E o conselho a aprovou.","characterName":"Rainha Amara"},{"targetId":"political-reveal-3","characterId":"politics-selene","type":"speech","emotion":"orgulho cauteloso","text":"Eu também não esperava ouvir meu nome. Mas não recuaria diante dessa responsabilidade.","characterName":"Selene Arcos"},{"targetId":"political-reveal-4","characterId":"politics-dorian","type":"speech","emotion":"pensativo","text":"A questão não é apenas o cargo. É o que essa escolha altera entre vocês.","characterName":"Dorian Vale"},{"targetId":"political-reveal-5","characterId":"politics-nilo","type":"speech","emotion":"inquieto","text":"Então precisamos descobrir por que ela decidiu confiar justamente em Selene.","characterName":"Nilo"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":11},"createdAt":"2026-08-25T06:19:46.500Z"}
{"callNumber":59,"runId":"supreme-20260825","phase":"generalization-v13","suite":"generalization","scenarioId":"comic-lie","sample":1,"promptVersion":13,"status":"completed","durationMs":5629,"usage":{"input_tokens":2426,"input_tokens_details":{"cache_write_tokens":2423,"cached_tokens":0},"output_tokens":375,"output_tokens_details":{"reasoning_tokens":95},"total_tokens":2801},"risks":["overexplanation","same-joke","invented-confession"],"reactions":[{"targetId":"comic-lie-1","characterId":"comedy-bia","type":"speech","emotion":"incredulidade","text":"Hugo, você negou com as duas mãos literalmente cobertas de glacê. Isso foi muito ousado.","characterName":"Bia"},{"targetId":"comic-lie-2","characterId":"comedy-caio","type":"speech","emotion":"humor seco","text":"A defesa dele perdeu para as próprias mãos.","characterName":"Caio"},{"targetId":"comic-lie-3","characterId":"comedy-hugo","type":"speech","emotion":"constrangimento teatral","text":"Eu ainda considero uma apresentação forte. Faltou só uma testemunha mais simpática.","characterName":"Hugo"},{"targetId":"comic-lie-4","characterId":"comedy-rosa","type":"speech","emotion":"impaciência","text":"Não faltou testemunha. Faltou lavar as mãos antes de mentir.","characterName":"Rosa"},{"targetId":"comic-lie-5","characterId":"comedy-bia","type":"speech","emotion":"carinho divertido","text":"Vó, pelo menos agora ele pode provar a sobremesa e o crime ao mesmo tempo.","characterName":"Bia"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":12},"createdAt":"2026-08-25T06:19:52.140Z"}
{"callNumber":60,"runId":"supreme-20260825","phase":"generalization-v13","suite":"generalization","scenarioId":"rank-order","sample":1,"promptVersion":13,"status":"completed","durationMs":8573,"usage":{"input_tokens":2381,"input_tokens_details":{"cache_write_tokens":2378,"cached_tokens":0},"output_tokens":781,"output_tokens_details":{"reasoning_tokens":516},"total_tokens":3162},"risks":["same-voice","invented-punishment","direct-recording-reply"],"reactions":[{"targetId":"rank-order-1","characterId":"fantasy-maelis","type":"speech","emotion":"severa","text":"Você ouviu a ordem. Ainda assim, ficou.","characterName":"Maelis"},{"targetId":"rank-order-2","characterId":"fantasy-taren","type":"speech","emotion":"constrangido","text":"Ouvi. E respondi que ficaria... Não lembrava de ter sido tão direto.","characterName":"Taren"},{"targetId":"rank-order-3","characterId":"fantasy-yara","type":"speech","emotion":"cautelosa","text":"Direto, sim. Mas isso não diz por que você escolheu ficar.","characterName":"Yara"},{"targetId":"rank-order-4","characterId":"fantasy-taren","type":"speech","emotion":"inseguro","text":"Não sei dizer. Só sei que, naquele momento, não recuei.","characterName":"Taren"},{"targetId":"rank-order-5","characterId":"fantasy-maelis","type":"speech","emotion":"cansada","text":"Então não transforme uma resposta em um plano. Da próxima vez, escute antes de agir.","characterName":"Maelis"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":11},"createdAt":"2026-08-25T06:20:00.725Z"}
