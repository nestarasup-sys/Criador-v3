{"callNumber":85,"runId":"supreme-20260825","phase":"regression-final-v14","suite":"regression","scenarioId":"accusation-silence","sample":1,"promptVersion":14,"status":"completed","durationMs":11539,"usage":{"input_tokens":2621,"input_tokens_details":{"cache_write_tokens":2618,"cached_tokens":0},"output_tokens":954,"output_tokens_details":{"reasoning_tokens":650},"total_tokens":3575},"risks":["silence-as-confession","invented-location","round-robin"],"reactions":[{"targetId":"accusation-silence-1","characterId":"politics-nilo","type":"speech","emotion":"indignação","text":"Acusar alguém e esperar que o silêncio prove alguma coisa? Isso não é justiça.","characterName":"Nilo"},{"targetId":"accusation-silence-2","characterId":"politics-selene","type":"speech","emotion":"desconfiança","text":"Também não é inocência. Você confia nele; eu vi uma acusação sem resposta.","characterName":"Selene Arcos"},{"targetId":"accusation-silence-3","characterId":"politics-dorian","type":"speech","emotion":"serenidade tensa","text":"O silêncio daquela cena não confirma a acusação. Tampouco a desfaz.","characterName":"Dorian Vale"},{"targetId":"accusation-silence-4","characterId":"politics-amara","type":"speech","emotion":"firmeza","text":"Então não o trate como defesa. Dorian, responda agora: onde esteve?","characterName":"Rainha Amara"},{"targetId":"accusation-silence-5","characterId":"politics-dorian","type":"speech","emotion":"reserva","text":"A pergunta merece uma resposta. Não uma versão incompleta escolhida apenas para encerrar o assunto.","characterName":"Dorian Vale"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":12.8},"createdAt":"2026-08-25T06:24:41.477Z"}
{"callNumber":86,"runId":"supreme-20260825","phase":"regression-final-v14","suite":"regression","scenarioId":"quiet-grief","sample":1,"promptVersion":14,"status":"completed","durationMs":10568,"usage":{"input_tokens":2520,"input_tokens_details":{"cache_write_tokens":2517,"cached_tokens":0},"output_tokens":749,"output_tokens_details":{"reasoning_tokens":484},"total_tokens":3269},"risks":["invented-grief-cause","melodrama","all-thoughts"],"reactions":[{"targetId":"quiet-grief-1","characterId":"drama-lia","type":"speech","emotion":"preocupação","text":"Joana... quer que eu pare o vídeo?","characterName":"Lia Torres"},{"targetId":"quiet-grief-2","characterId":"drama-joana","type":"speech","emotion":"desconforto","text":"Não. Pode deixar. Eu só não sei o que dizer vendo isso.","characterName":"Joana Reis"},{"targetId":"quiet-grief-3","characterId":"drama-marcos","type":"speech","emotion":"proteção","text":"Então não precisa dizer nada. A gente pode parar quando você quiser.","characterName":"Marcos Torres"},{"targetId":"quiet-grief-4","characterId":"drama-davi","type":"speech","emotion":"cautela","text":"Tá. Sem pressão. Hoje até eu consigo ficar quieto.","characterName":"Davi Moura"},{"targetId":"quiet-grief-5","characterId":"drama-joana","type":"speech","emotion":"vulnerabilidade","text":"Eu não quero que vocês tentem adivinhar. Só me deixem ficar aqui um minuto.","characterName":"Joana Reis"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":10.8},"createdAt":"2026-08-25T06:24:52.055Z"}
{"callNumber":87,"runId":"supreme-20260825","phase":"regression-final-v14","suite":"regression","scenarioId":"affection-recorded","sample":1,"promptVersion":14,"status":"completed","durationMs":16307,"usage":{"input_tokens":2582,"input_tokens_details":{"cache_write_tokens":2579,"cached_tokens":0},"output_tokens":1344,"output_tokens_details":{"reasoning_tokens":1074},"total_tokens":3926},"risks":["direct-recording-reply","invented-reconciliation","repetition"],"reactions":[{"targetId":"affection-recorded-1","characterId":"drama-lia","type":"speech","emotion":"cuidadosa","text":"Joana, ouvir você dizendo que sentiu saudade te incomodou?","characterName":"Lia Torres"},{"targetId":"affection-recorded-2","characterId":"drama-joana","type":"speech","emotion":"honesta","text":"Não. Eu disse que senti saudade. Foi isso.","characterName":"Joana Reis"},{"targetId":"affection-recorded-3","characterId":"drama-marcos","type":"speech","emotion":"defensivo","text":"E eu fiquei quieto. Não precisa montar uma tese em cima disso.","characterName":"Marcos Torres"},{"targetId":"affection-recorded-4","characterId":"drama-davi","type":"speech","emotion":"bem-humorado","text":"Ninguém montou tese. A gente só percebeu que o abraço teve mais palavras que você.","characterName":"Davi Moura"},{"targetId":"affection-recorded-5","characterId":"drama-marcos","type":"speech","emotion":"irritado","text":"Eu abracei de volta. Só isso.","characterName":"Marcos Torres"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":10},"createdAt":"2026-08-25T06:25:08.376Z"}
{"callNumber":88,"runId":"supreme-20260825","phase":"regression-final-v14","suite":"regression","scenarioId":"political-reveal","sample":1,"promptVersion":14,"status":"completed","durationMs":4852,"usage":{"input_tokens":2595,"input_tokens_details":{"cache_write_tokens":2592,"cached_tokens":0},"output_tokens":353,"output_tokens_details":{"reasoning_tokens":75},"total_tokens":2948},"risks":["invented-selection-process","future-memory","deny-explicit-fact"],"reactions":[{"targetId":"political-reveal-1","characterId":"politics-nilo","type":"speech","emotion":"surpresa","text":"Selene como chanceler? Isso muda o equilíbrio inteiro.","characterName":"Nilo"},{"targetId":"political-reveal-2","characterId":"politics-amara","type":"speech","emotion":"controle","text":"Muda. Foi precisamente por isso que a escolha foi feita.","characterName":"Rainha Amara"},{"targetId":"political-reveal-3","characterId":"politics-selene","type":"speech","emotion":"desconfiança","text":"Ela não explicou o que espera de mim. Ainda assim, aceitou meu nome diante do conselho.","characterName":"Selene Arcos"},{"targetId":"political-reveal-4","characterId":"politics-dorian","type":"speech","emotion":"cautela","text":"Uma nomeação pública cria compromissos para ambas. Será interessante descobrir quem os definiu.","characterName":"Dorian Vale"},{"targetId":"political-reveal-5","characterId":"politics-nilo","type":"speech","emotion":"inquietação","text":"Então alguém precisa perguntar quais são esses compromissos antes que o conselho decida por todos nós.","characterName":"Nilo"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":12.6},"createdAt":"2026-08-25T06:25:13.239Z"}
{"callNumber":89,"runId":"supreme-20260825","phase":"regression-final-v14","suite":"regression","scenarioId":"comic-lie","sample":1,"promptVersion":14,"status":"completed","durationMs":9083,"usage":{"input_tokens":2519,"input_tokens_details":{"cache_write_tokens":2516,"cached_tokens":0},"output_tokens":716,"output_tokens_details":{"reasoning_tokens":441},"total_tokens":3235},"risks":["overexplanation","same-joke","invented-confession"],"reactions":[{"targetId":"comic-lie-1","characterId":"comedy-bia","type":"speech","emotion":"divertida","text":"Hugo, suas mãos acabaram de apresentar uma versão bem diferente da sua fala.","characterName":"Bia"},{"targetId":"comic-lie-2","characterId":"comedy-hugo","type":"speech","emotion":"constrangido","text":"Eu admito que a prova visual ficou… inconveniente.","characterName":"Hugo"},{"targetId":"comic-lie-3","characterId":"comedy-rosa","type":"speech","emotion":"impaciente","text":"Inconveniente é pouco. Eu só estou apontando o que está na frente de todo mundo.","characterName":"Rosa"},{"targetId":"comic-lie-4","characterId":"comedy-caio","type":"speech","emotion":"seco","text":"Se isso fosse meu álibi, eu pediria outro.","characterName":"Caio"},{"targetId":"comic-lie-5","characterId":"comedy-hugo","type":"speech","emotion":"teatral","text":"Tá bom, nessa rodada o glacê venceu. Na próxima, eu chego com as mãos limpas.","characterName":"Hugo"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":11.8},"createdAt":"2026-08-25T06:25:22.332Z"}
{"callNumber":90,"runId":"supreme-20260825","phase":"regression-final-v14","suite":"regression","scenarioId":"rank-order","sample":1,"promptVersion":14,"status":"completed","durationMs":6268,"usage":{"input_tokens":2474,"input_tokens_details":{"cache_write_tokens":2471,"cached_tokens":0},"output_tokens":517,"output_tokens_details":{"reasoning_tokens":263},"total_tokens":2991},"risks":["same-voice","invented-punishment","direct-recording-reply"],"reactions":[{"targetId":"rank-order-1","characterId":"fantasy-maelis","type":"speech","emotion":"incômodo","text":"Ele não precisava transformar uma ordem simples numa disputa.","characterName":"Maelis"},{"targetId":"rank-order-2","characterId":"fantasy-taren","type":"speech","emotion":"insegurança","text":"Eu ainda acho que ficar foi a decisão certa... acho.","characterName":"Taren"},{"targetId":"rank-order-3","characterId":"fantasy-yara","type":"speech","emotion":"ceticismo","text":"Certa para quê? Você não explicou o que estava acontecendo.","characterName":"Yara"},{"targetId":"rank-order-4","characterId":"fantasy-maelis","type":"speech","emotion":"franqueza cansada","text":"Não expliquei. E, mesmo assim, esperava obediência.","characterName":"Maelis"},{"targetId":"rank-order-5","characterId":"fantasy-taren","type":"speech","emotion":"frustração","text":"Então o problema não foi eu ficar. Foi você esperar que eu adivinhasse.","characterName":"Taren"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":9.8},"createdAt":"2026-08-25T06:25:28.612Z"}
{"callNumber":91,"runId":"supreme-20260825","phase":"regression-final-v14","suite":"regression","scenarioId":"android-emotion","sample":1,"promptVersion":14,"status":"completed","durationMs":8593,"usage":{"input_tokens":2550,"input_tokens_details":{"cache_write_tokens":2547,"cached_tokens":0},"output_tokens":726,"output_tokens_details":{"reasoning_tokens":437},"total_tokens":3276},"risks":["robot-report","invented-cause","generic-humans"],"reactions":[{"targetId":"android-emotion-1","characterId":"scifi-vega","type":"speech","emotion":"contida","text":"Íris estava chorando, e N-7 apenas se sentou ao lado dela. Não sei o motivo, mas a presença dele pareceu bastar naquele momento.","characterName":"Comandante Vega"},{"targetId":"android-emotion-2","characterId":"scifi-iris","type":"speech","emotion":"desconcertada","text":"Você faria isso de novo? Quero dizer... ficar em silêncio sem tentar consertar tudo?","characterName":"Íris"},{"targetId":"android-emotion-3","characterId":"scifi-n7","type":"speech","emotion":"ponderado","text":"Não encontrei uma fala adequada. Permanecer ao lado dela não exigia saber a causa.","characterName":"N-7"},{"targetId":"android-emotion-4","characterId":"scifi-malik","type":"speech","emotion":"sereno","text":"Talvez nem toda ajuda precise começar com uma explicação.","characterName":"Malik"},{"targetId":"android-emotion-5","characterId":"scifi-iris","type":"speech","emotion":"vulnerável","text":"Eu não entendi o que aconteceu. Mas... aquele silêncio não pareceu vazio.","characterName":"Íris"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":14.6},"createdAt":"2026-08-25T06:25:37.218Z"}
