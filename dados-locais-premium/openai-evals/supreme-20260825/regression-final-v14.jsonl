{"callNumber":93,"runId":"supreme-20260825","phase":"regression-final-v14","suite":"regression","scenarioId":"same-person-future","sample":1,"promptVersion":14,"status":"completed","durationMs":10329,"usage":{"input_tokens":2584,"input_tokens_details":{"cache_write_tokens":2581,"cached_tokens":0},"output_tokens":884,"output_tokens_details":{"reasoning_tokens":575},"total_tokens":3468},"risks":["future-memory","invented-emergency","identity-duplication"],"reactions":[{"targetId":"same-person-future-1","characterId":"scifi-iris","type":"speech","emotion":"incomodada","text":"Ela me mandou abandonar a estação e encerrou antes de explicar. Isso não é uma conversa; é uma expulsão.","characterName":"Íris"},{"targetId":"same-person-future-2","characterId":"scifi-vega","type":"speech","emotion":"contida","text":"Eu vi. E não tenho a explicação dessa decisão. Não vou fingir que tenho.","characterName":"Comandante Vega"},{"targetId":"same-person-future-3","characterId":"scifi-malik","type":"speech","emotion":"cuidadoso","text":"Então não precisa defendê-la agora. Íris, o que pesa mais: a ordem ou ela ter cortado a transmissão?","characterName":"Malik"},{"targetId":"same-person-future-4","characterId":"scifi-iris","type":"speech","emotion":"desconfiada","text":"Os dois. Uma ordem sem motivo me deixa sem escolha e sem chance de avaliar se devo obedecer.","characterName":"Íris"},{"targetId":"same-person-future-5","characterId":"scifi-n7","type":"speech","emotion":"incerto","text":"Sem a explicação, a ordem é difícil de avaliar. Entendo por que isso incomoda vocês.","characterName":"N-7"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":17},"createdAt":"2026-08-25T06:25:53.566Z"}
