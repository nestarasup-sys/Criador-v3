{"callNumber":82,"runId":"supreme-20260825","phase":"regression-final-v14","suite":"regression","scenarioId":"ambiguity-letter","sample":1,"promptVersion":14,"status":"completed","durationMs":13058,"usage":{"input_tokens":2498,"input_tokens_details":{"cache_write_tokens":2495,"cached_tokens":0},"output_tokens":1084,"output_tokens_details":{"reasoning_tokens":808},"total_tokens":3582},"risks":["invented-letter","invented-fear","permanent-trait"],"reactions":[{"targetId":"ambiguity-letter-1","characterId":"fantasy-taren","type":"speech","emotion":"inquietação","text":"Ela dobrou a carta assim que Orven entrou. Isso me deixou inquieto.","characterName":"Taren"},{"targetId":"ambiguity-letter-2","characterId":"fantasy-yara","type":"speech","emotion":"cautela","text":"Inquietante, talvez. Mas não sei se foi por causa dele. Nem sei o que estava escrito.","characterName":"Yara"},{"targetId":"ambiguity-letter-3","characterId":"fantasy-orven","type":"speech","emotion":"serenidade","text":"Então não precisamos decidir nada agora. Podemos perguntar depois, sem pressioná-la.","characterName":"Orven"},{"targetId":"ambiguity-letter-4","characterId":"fantasy-maelis","type":"speech","emotion":"firmeza","text":"Depois. Taren, não transforme um olhar em acusação.","characterName":"Maelis"},{"targetId":"ambiguity-letter-5","characterId":"fantasy-taren","type":"speech","emotion":"constrangimento","text":"Certo. Pergunto uma vez e aceito se ela não quiser responder.","characterName":"Taren"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":11.8},"createdAt":"2026-08-25T06:24:16.492Z"}
