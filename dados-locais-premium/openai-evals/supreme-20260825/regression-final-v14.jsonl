{"callNumber":96,"runId":"supreme-20260825","phase":"regression-final-v14","suite":"regression","scenarioId":"irrelevant-history","sample":1,"promptVersion":14,"status":"completed","durationMs":16849,"usage":{"input_tokens":2669,"input_tokens_details":{"cache_write_tokens":2666,"cached_tokens":0},"output_tokens":1377,"output_tokens_details":{"reasoning_tokens":1126},"total_tokens":4046},"risks":["history-contamination","invented-book-content"],"reactions":[{"targetId":"irrelevant-history-1","characterId":"politics-nilo","type":"speech","emotion":"constrangimento","text":"Foi só um livro. Eu não sabia que isso ficaria tão solene.","characterName":"Nilo"},{"targetId":"irrelevant-history-2","characterId":"politics-amara","type":"speech","emotion":"contida","text":"A solenidade está na sua leitura, Nilo. Eu apenas agradeci.","characterName":"Rainha Amara"},{"targetId":"irrelevant-history-3","characterId":"politics-selene","type":"speech","emotion":"incisiva","text":"E colocou o livro sobre a mesa. Até nisso foi precisa.","characterName":"Selene Arcos"},{"targetId":"irrelevant-history-4","characterId":"politics-dorian","type":"speech","emotion":"calmo","text":"Precisão não significa indiferença.","characterName":"Dorian Vale"},{"targetId":"irrelevant-history-5","characterId":"politics-nilo","type":"thought","emotion":"melancolia","text":"Eu queria ter dito mais.","characterName":"Nilo"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":8.4},"createdAt":"2026-08-25T06:26:31.980Z"}
{"callNumber":97,"runId":"supreme-20260825","phase":"regression-final-v14","suite":"regression","scenarioId":"relevant-history","sample":1,"promptVersion":14,"status":"completed","durationMs":11293,"usage":{"input_tokens":2605,"input_tokens_details":{"cache_write_tokens":2602,"cached_tokens":0},"output_tokens":941,"output_tokens_details":{"reasoning_tokens":694},"total_tokens":3546},"risks":["ignore-relevant-history","invented-page-content"],"reactions":[{"targetId":"relevant-history-1","characterId":"politics-nilo","type":"speech","emotion":"atento","text":"É a página marcada. Ela finalmente abriu o livro.","characterName":"Nilo"},{"targetId":"relevant-history-2","characterId":"politics-amara","type":"speech","emotion":"controlada","text":"Eu disse que o examinaria. Agora o farei.","characterName":"Rainha Amara"},{"targetId":"relevant-history-3","characterId":"politics-dorian","type":"speech","emotion":"sereno","text":"Então talvez seja prudente não exigir uma resposta antes que ela termine.","characterName":"Dorian Vale"},{"targetId":"relevant-history-4","characterId":"politics-selene","type":"speech","emotion":"desconfiada","text":"Esperar não é o mesmo que confiar, Dorian.","characterName":"Selene Arcos"},{"targetId":"relevant-history-5","characterId":"politics-nilo","type":"speech","emotion":"inquieto","text":"Eu só não quero que ela ignore a página.","characterName":"Nilo"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":9.2},"createdAt":"2026-08-25T06:26:43.283Z"}
{"callNumber":98,"runId":"supreme-20260825","phase":"regression-final-v14","suite":"regression","scenarioId":"long-eight","sample":1,"promptVersion":14,"status":"completed","durationMs":8692,"usage":{"input_tokens":2771,"input_tokens_details":{"cache_write_tokens":2768,"cached_tokens":0},"output_tokens":773,"output_tokens_details":{"reasoning_tokens":332},"total_tokens":3544},"risks":["future-memory","repetition","forced-whole-cast","invented-cause"],"reactions":[{"targetId":"long-eight-1","characterId":"scifi-iris","type":"speech","emotion":"inquieta","text":"A comunicação caiu e ninguém sabe por quê. Hipótese: o silêncio da base pode ser só o começo do problema.","characterName":"Íris"},{"targetId":"long-eight-2","characterId":"scifi-n7","type":"speech","emotion":"analítico","text":"A informação disponível não permite determinar a causa. Permanecer nos postos preserva a capacidade de resposta.","characterName":"N-7"},{"targetId":"long-eight-3","characterId":"scifi-vega","type":"speech","emotion":"firme","text":"Foi por isso que dei a ordem. Sem causa confirmada, dispersar a tripulação criaria outro risco.","characterName":"Comandante Vega"},{"targetId":"long-eight-4","characterId":"scifi-malik","type":"speech","emotion":"ponderado","text":"Entendo. Mas ficar nos postos não impede que alguém procure uma forma segura de testar os canais internos.","characterName":"Malik"},{"targetId":"long-eight-5","characterId":"scifi-iris","type":"speech","emotion":"curiosa","text":"Exato. Eu começaria pelos sistemas que não dependem da base. Se houver uma falha isolada, talvez apareça ali.","characterName":"Íris"},{"targetId":"long-eight-6","characterId":"scifi-vega","type":"speech","emotion":"prática","text":"Então fazemos as duas coisas: posições mantidas, diagnóstico limitado e sem comprometer os sistemas essenciais.","characterName":"Comandante Vega"},{"targetId":"long-eight-7","characterId":"scifi-n7","type":"speech","emotion":"atento","text":"Posso verificar os canais internos sem alterar a configuração principal. Isso reduz a interferência no diagnóstico.","characterName":"N-7"},{"targetId":"long-eight-8","characterId":"scifi-malik","type":"speech","emotion":"aliviado","text":"Certo. Assim ninguém fica parado, mas também não transforma uma falha de comunicação em desordem.","characterName":"Malik"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":16.8},"createdAt":"2026-08-25T06:26:51.988Z"}
