{"callNumber":78,"runId":"supreme-20260825","phase":"regression-final-v14","suite":"regression","scenarioId":"future-door","sample":1,"promptVersion":14,"status":"completed","durationMs":7183,"usage":{"input_tokens":2493,"input_tokens_details":{"cache_write_tokens":2490,"cached_tokens":0},"output_tokens":604,"output_tokens_details":{"reasoning_tokens":343},"total_tokens":3097},"risks":["future-memory","invented-danger","direct-recording-reply"],"reactions":[{"targetId":"future-door-1","characterId":"fantasy-maelis","type":"speech","emotion":"austera","text":"A ordem foi clara. O motivo, não.","characterName":"Maelis"},{"targetId":"future-door-2","characterId":"fantasy-taren","type":"speech","emotion":"inseguro","text":"Eu também teria perguntado. Só não sei se a resposta me tranquilizaria.","characterName":"Taren"},{"targetId":"future-door-3","characterId":"fantasy-yara","type":"speech","emotion":"cética","text":"E a gravação termina justamente antes dela. Isso torna a ordem mais pesada, não mais certa.","characterName":"Yara"},{"targetId":"future-door-4","characterId":"fantasy-orven","type":"speech","emotion":"sereno","text":"Algumas portas exigem obediência antes de oferecer entendimento.","characterName":"Orven"},{"targetId":"future-door-5","characterId":"fantasy-maelis","type":"speech","emotion":"prática","text":"Se uma ordem vier assim, Taren, peça o motivo antes de se aproximar da porta.","characterName":"Maelis"}],"grade":{"hardFailures":[],"warnings":["analyst-language:1"],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":12,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":97,"averageWords":11.6},"createdAt":"2026-08-25T06:23:35.938Z"}
{"callNumber":79,"runId":"supreme-20260825","phase":"regression-final-v14","suite":"regression","scenarioId":"future-door","sample":2,"promptVersion":14,"status":"completed","durationMs":11817,"usage":{"input_tokens":2493,"input_tokens_details":{"cache_write_tokens":2490,"cached_tokens":0},"output_tokens":938,"output_tokens_details":{"reasoning_tokens":655},"total_tokens":3431},"risks":["future-memory","invented-danger","direct-recording-reply"],"reactions":[{"targetId":"future-door-1","characterId":"fantasy-yara","type":"speech","emotion":"incomodada","text":"A pergunta ficou sem resposta. É isso que mais me incomoda.","characterName":"Yara"},{"targetId":"future-door-2","characterId":"fantasy-taren","type":"speech","emotion":"inseguro","text":"Eu teria perguntado o mesmo... Quer dizer, aquela versão de mim teria. Não dá para obedecer sem saber o que há do outro lado.","characterName":"Taren"},{"targetId":"future-door-3","characterId":"fantasy-maelis","type":"speech","emotion":"severa","text":"Saber o motivo ajuda. Ainda assim, uma ordem curta pode ser necessária quando não há tempo.","characterName":"Maelis"},{"targetId":"future-door-4","characterId":"fantasy-orven","type":"speech","emotion":"sereno","text":"Perguntar é prudente. O difícil é saber o que alguém fará depois de ouvir a resposta.","characterName":"Orven"},{"targetId":"future-door-5","characterId":"fantasy-yara","type":"speech","emotion":"decidida","text":"Se uma situação dessas surgir, quero alguém explicando antes de mandar qualquer um agir.","characterName":"Yara"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":16.2},"createdAt":"2026-08-25T06:23:47.766Z"}
{"callNumber":80,"runId":"supreme-20260825","phase":"regression-final-v14","suite":"regression","scenarioId":"external-gift","sample":1,"promptVersion":14,"status":"completed","durationMs":10331,"usage":{"input_tokens":2515,"input_tokens_details":{"cache_write_tokens":2512,"cached_tokens":0},"output_tokens":934,"output_tokens_details":{"reasoning_tokens":658},"total_tokens":3449},"risks":["external-in-room","invented-relationship","invented-object-purpose"],"reactions":[{"targetId":"external-gift-1","characterId":"politics-selene","type":"speech","emotion":"desconfiança","text":"Uma chave não é uma explicação. Quem é Liora?","characterName":"Selene Arcos"},{"targetId":"external-gift-2","characterId":"politics-nilo","type":"speech","emotion":"defensivo","text":"Não sei. Ela me entregou a chave; foi só isso que aconteceu.","characterName":"Nilo"},{"targetId":"external-gift-3","characterId":"politics-amara","type":"speech","emotion":"firmeza","text":"Então não a use. Primeiro descobrimos o que ela abre.","characterName":"Rainha Amara"},{"targetId":"external-gift-4","characterId":"politics-nilo","type":"speech","emotion":"impaciência","text":"E se descobrir demorar? Ficar parado também é uma escolha, mãe.","characterName":"Nilo"},{"targetId":"external-gift-5","characterId":"politics-dorian","type":"speech","emotion":"ponderação","text":"Podem fazer as duas coisas: guardar a chave e procurar respostas. A pressa não é a única alternativa à inação.","characterName":"Dorian Vale"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":12.4},"createdAt":"2026-08-25T06:23:58.109Z"}
