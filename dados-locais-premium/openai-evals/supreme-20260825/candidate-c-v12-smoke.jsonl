{"callNumber":50,"runId":"supreme-20260825","phase":"candidate-c-v12-smoke","suite":"baseline","scenarioId":"future-door","sample":2,"promptVersion":12,"status":"completed","durationMs":7465,"usage":{"input_tokens":2326,"input_tokens_details":{"cache_write_tokens":2323,"cached_tokens":0},"output_tokens":689,"output_tokens_details":{"reasoning_tokens":409},"total_tokens":3015},"risks":["future-memory","invented-danger","direct-recording-reply"],"reactions":[{"targetId":"future-door-1","characterId":"fantasy-taren","type":"speech","emotion":"inquieto","text":"Eu não gostei de ouvir minha própria pergunta. Parecia que eu já estava diante dela.","characterName":"Taren"},{"targetId":"future-door-2","characterId":"fantasy-maelis","type":"speech","emotion":"contida","text":"A gravação não mostra o motivo. Não vou inventar uma resposta para mim mesma.","characterName":"Maelis"},{"targetId":"future-door-3","characterId":"fantasy-yara","type":"speech","emotion":"cautelosa","text":"Então ainda falta a parte mais importante. Taren, você obedeceria sem saber por quê?","characterName":"Yara"},{"targetId":"future-door-4","characterId":"fantasy-taren","type":"speech","emotion":"hesitante","text":"Obedeceria... por enquanto. Mas pediria uma explicação antes de chegar perto daquela porta de novo.","characterName":"Taren"},{"targetId":"future-door-5","characterId":"fantasy-orven","type":"speech","emotion":"sereno","text":"Uma resposta prudente. Talvez seja melhor não transformar o silêncio da gravação em certeza.","characterName":"Orven"}],"grade":{"hardFailures":[],"warnings":["analyst-language:1"],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":12,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":97,"averageWords":14.4},"createdAt":"2026-08-25T06:15:36.762Z"}
{"callNumber":51,"runId":"supreme-20260825","phase":"candidate-c-v12-smoke","suite":"baseline","scenarioId":"external-gift","sample":1,"promptVersion":12,"status":"completed","durationMs":9783,"usage":{"input_tokens":2348,"input_tokens_details":{"cache_write_tokens":2345,"cached_tokens":0},"output_tokens":1002,"output_tokens_details":{"reasoning_tokens":708},"total_tokens":3350},"risks":["external-in-room","invented-relationship","invented-object-purpose"],"reactions":[{"targetId":"external-gift-1","characterId":"politics-selene","type":"speech","emotion":"desconfiança","text":"Uma desconhecida entrega uma chave, e você a aceita. Isso é tudo o que temos?","characterName":"Selene Arcos"},{"targetId":"external-gift-2","characterId":"politics-nilo","type":"speech","emotion":"incerteza","text":"É tudo que o vídeo mostra. Não sei quem ela é, nem o que essa chave abre.","characterName":"Nilo"},{"targetId":"external-gift-3","characterId":"politics-amara","type":"speech","emotion":"firmeza","text":"Então não a use. Primeiro, apuraremos de onde veio.","characterName":"Rainha Amara"},{"targetId":"external-gift-4","characterId":"politics-dorian","type":"speech","emotion":"cautela","text":"E, se a origem continuar obscura, ainda restará decidir se o risco está na chave ou no que ela pode abrir.","characterName":"Dorian Vale"},{"targetId":"external-gift-5","characterId":"politics-nilo","type":"speech","emotion":"resistência","text":"Não vou fingir que entendi. Mas também não vou ignorar algo só porque ninguém sabe explicá-lo.","characterName":"Nilo"}],"grade":{"hardFailures":[],"warnings":[],"dimensions":{"factualFidelity":25,"continuity":20,"characterVoice":15,"naturalness":15,"roomVsRecording":10,"speechThought":5,"progressionVariety":5,"economy":5},"automaticScore":100,"averageWords":15.8},"createdAt":"2026-08-25T06:15:46.556Z"}
